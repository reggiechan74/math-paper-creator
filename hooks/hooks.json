{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/setup_env.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(//**/*.model.md)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/validate-model-md.sh"],
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Edit(//**/*.model.md)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/validate-model-md.sh"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
