{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/setup_env.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(//**/*.model.md)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/validate-model-md.sh"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Edit(//**/*.model.md)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/validate-model-md.sh"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/mpc",
              "--python",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"
            ],
            "timeout": 120,
            "if": "Write(//**/*.model.md)"
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/mpc",
              "--python",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"
            ],
            "timeout": 120,
            "if": "Edit(//**/*.model.md)"
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/mpc",
              "--python",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"
            ],
            "timeout": 120,
            "if": "Write(//**/*.proofs.json)"
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/mpc",
              "--python",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"
            ],
            "timeout": 120,
            "if": "Edit(//**/*.proofs.json)"
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/mpc",
              "--python",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"
            ],
            "timeout": 120,
            "if": "Bash(*approve*)"
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/mpc",
              "--python",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"
            ],
            "timeout": 120,
            "if": "Bash(*.proofs.json*)"
          }
        ]
      }
    ]
  }
}
